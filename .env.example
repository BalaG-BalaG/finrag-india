PG_DSN=postgresql://postgres:postgres@localhost:5432/finrag
# --- embeddings / reranker / NLI (all swappable) ---
EMBED_BACKEND=st                       # st | hash (hash = offline CI only)
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VERIFY_BACKEND=llm                     # none | llm | nli
NLI_MODEL=cross-encoder/nli-deberta-v3-base
# --- generator: any OpenAI-compatible endpoint ---
LLM_BASE_URL=http://localhost:11434/v1 # Ollama default; or your provider's OpenAI-compatible URL
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
# --- abstention thresholds (calibrate on dev split, do not hard-code in the thesis) ---
TAU_RERANK=0.20
TAU_HIGH=0.90
TAU_LOW=0.60
MAX_ITERS=2
